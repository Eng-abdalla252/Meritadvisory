[
    {
        "id": "contact",
        "title": "Contact Us Form",
        "description": "Used on the main landing page contact section to collect general inquiries.",
        "submitButtonText": "Send Message",
        "successMessage": "Thank you! Your message has been sent successfully. We will get back to you soon.",
        "fields": [
            {
                "id": "name",
                "label": "Full Name",
                "type": "text",
                "placeholder": "Enter your full name",
                "required": true,
                "order": 1
            },
            {
                "id": "email",
                "label": "Email Address",
                "type": "email",
                "placeholder": "Enter your email address",
                "required": true,
                "order": 2
            },
            {
                "id": "phone",
                "label": "Phone Number",
                "type": "phone",
                "placeholder": "e.g. +252 90 6XXXXXX",
                "required": false,
                "order": 3
            },
            {
                "id": "company",
                "label": "Company / Organization",
                "type": "text",
                "placeholder": "Your company name",
                "required": false,
                "order": 4
            },
            {
                "id": "category",
                "label": "Inquiry Type",
                "type": "select",
                "placeholder": "Select topic",
                "required": true,
                "options": [
                    "General Inquiry",
                    "ERP Consultation",
                    "Audit & Assurance",
                    "Tax Optimization",
                    "Merit Training Hub",
                    "Careers & Recruitment"
                ],
                "order": 5
            },
            {
                "id": "subject",
                "label": "Subject",
                "type": "text",
                "placeholder": "How can we help you?",
                "required": true,
                "order": 6
            },
            {
                "id": "message",
                "label": "Your Message",
                "type": "textarea",
                "placeholder": "Write your detailed message here...",
                "required": true,
                "order": 7
            }
        ]
    },
    {
